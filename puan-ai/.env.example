# Salin file ini menjadi ".env" lalu isi. JANGAN pernah commit file .env ke GitHub.

# Wajib: kunci Gemini API milikmu sendiri (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Disarankan: kunci rahasia antara Next.js dan FastAPI (buat acak, mis. 32 karakter).
# Harus SAMA dengan PUAN_API_KEY di web/.env.local. Kosongkan hanya saat mencoba di komputer sendiri.
PUAN_API_KEY=

# Origin web yang boleh memanggil API langsung dari browser (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:3000

# Pilihan RAG
PUAN_EMBED=gemini          # gemini | e5
PUAN_PECAH_HURUF=1         # 1 = daftar panjang dipecah per huruf (teruji 90%, dipakai di server online), 0 = tanpa pecah (87,5%)
# PUAN_AMBANG=0.60         # isi hanya kalau ingin menimpa ambang bawaan model
# PUAN_MODEL_JAWAB=gemini-3.6-flash
# PUAN_MODEL_TULIS_ULANG=gemini-3.1-flash-lite

# 1 = respons API menyertakan kueri & skor (untuk debugging, JANGAN di produksi)
PUAN_DEBUG=0

# Opsional: rekap topik ANONIM dan umpan balik suka/tidak suka ke Supabase (lihat puan_rag/statistik.py).
# SUPABASE_SECRET_KEY adalah kunci induk (sb_secret_...). Hanya untuk server, JANGAN taruh di web atau browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Nyalakan HANYA di server online (Vercel). Di laptop biarkan mati supaya tes tidak mengotori rekap.
# PUAN_CATAT_STATISTIK=1
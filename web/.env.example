# Salin file ini menjadi ".env.local" (di folder web) lalu isi. JANGAN pernah commit file .env.local ke GitHub.

# Supabase (untuk daftar pinjol). Kunci PUBLISHABLE boleh ada di browser, BUKAN kunci secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Alamat server Puan AI. Di laptop: http://localhost:8000 (jalankan uvicorn di folder puan-ai)
PUAN_API_URL=http://localhost:8000

# Harus SAMA dengan PUAN_API_KEY di puan-ai/.env. Rahasia: tanpa awalan NEXT_PUBLIC_, jadi tidak terkirim ke browser.
PUAN_API_KEY=
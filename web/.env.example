# Salin file ini menjadi ".env.local" (di folder web) lalu isi. JANGAN pernah commit file .env.local ke GitHub.

# Supabase (untuk daftar pinjol). Kunci PUBLISHABLE boleh ada di browser, BUKAN kunci secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Kunci SECRET Supabase (diawali sb_secret_). Dipakai server untuk pembatas permintaan (lib/api/pembatas.ts).
# Rahasia: tanpa awalan NEXT_PUBLIC_, jadi tidak terkirim ke browser. Minta nilainya lewat chat pribadi.
SUPABASE_SECRET_KEY=

# Puan AI (berjalan di Next.js, lib/puan). Kunci Gemini dari Google AI Studio.
# Rahasia: tanpa awalan NEXT_PUBLIC_, jadi tidak terkirim ke browser. Jangan dikirim ke grup atau GitHub.
GEMINI_API_KEY=
# 1 = catat rekap ANONIM (topik/status, tanpa isi chat) + umpan balik ke Supabase. Kosongkan di laptop kalau tidak perlu.
PUAN_CATAT_STATISTIK=

# Alamat server Puan AI. Di laptop: http://localhost:8000 (jalankan uvicorn di folder puan-ai)
PUAN_API_URL=http://localhost:8000

# Harus SAMA dengan PUAN_API_KEY di puan-ai/.env. Rahasia: tanpa awalan NEXT_PUBLIC_, jadi tidak terkirim ke browser.
PUAN_API_KEY=


# Kunci admin untuk endpoint tulis pinjol/artikel/lembaga (header X-Admin-Key).
# Buat sendiri: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rahasia: tanpa awalan NEXT_PUBLIC_. Jangan dikirim ke grup atau GitHub.
ADMIN_API_KEY=